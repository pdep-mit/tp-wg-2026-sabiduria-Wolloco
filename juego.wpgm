import wollok.game.*
import anzuelo.*
import peces.*
import piedra.*

program NombreDeJuego {
	game.title("Grupo: wolloco | Bajo el hielo")
	game.height(10)
	game.width(10)
	game.boardGround("fondo.jpg")
	
	game.addVisual(anzuelo)
	game.addVisual(marcadorPuntos)
	game.addVisual(piedra)
  game.addVisual(marcadorVidas)

	
	
	const pecesComunes = [
		new PezComun(position = game.at(0, 1.randomUpTo(6)), orientacion = derecha),
		new PezComun(
			position = game.at(game.width() - 1, 1.randomUpTo(6)),
			orientacion = izquierda
		)
	]
	
	const pecesRapidos = [
		new PezRapido(position = game.at(0, 1.randomUpTo(6)), orientacion = derecha),
		new PezRapido(
			position = game.at(game.width() - 1, 1.randomUpTo(6)),
			orientacion = izquierda
		)
	]

  const pezVenenoso = [
    new PezVenenoso(position = game.at(0, 1.randomUpTo(5)), orientacion = derecha),
    new PezVenenoso(position = game.at(game.width() - 1, 3.randomUpTo(6)), orientacion = izquierda)
  ]

  pezVenenoso.forEach({ pez => game.addVisual(pez) })
	game.onTick(180, "movimientoPezVenenoso", { pezVenenoso.forEach({ pez => pez.mover() }) })

	pecesComunes.forEach({ pez => game.addVisual(pez) })
	pecesRapidos.forEach({ pez => game.addVisual(pez) })
	
	game.onTick(
		100,
		"movimientoPezRapido",
		{ pecesRapidos.forEach({ pez => pez.mover() }) }
	)
	game.onTick(
		220,
		"movimientoPezComun",
		{ pecesComunes.forEach({ pez => pez.mover() }) }
	)

	game.onTick(250, "movimientoPiedra", { piedra.mover() })
	game.onTick(100, "moverPezAgarrado", { anzuelo.moverPezAgarrado() })
	
	keyboard.up().onPressDo({ anzuelo.subirAnzuelo() })
	keyboard.down().onPressDo({ anzuelo.bajarAnzuelo() })
	keyboard.space().onPressDo({ anzuelo.soltar() })
	
	game.whenCollideDo(anzuelo, { elemento => elemento.interactuarCon(anzuelo) })
	//polimorfica ya que cada elemento entiende interactuarCon el anzuelo y lo maneja a su propia forma
	game.start()
}