import wollok.game.*
import anzuelo.*
import peces.*

program NombreDeJuego {
	// TODO: Cambiar esto por lo que necesiten
	game.title("Grupo: wolloco | Bajo el hielo")
	game.height(10)
	game.width(10)
	game.boardGround("fondo.jpg")
	
	game.addVisual(anzuelo)
	game.addVisual(marcadorPuntos)
	
	const peces = [
		new PezRapido(position = game.at(0, 2), orientacion = derecha),
		new PezRapido(position = game.at(9, 4), orientacion = izquierda),
		new PezComun(position = game.at(1, 6), orientacion = derecha),
		new PezComun(position = game.at(8, 8), orientacion = izquierda)
	]
	
	peces.forEach({ pez => game.addVisual(pez) })
	
	game.onTick(100, "movimientoPeces", { peces.forEach({ pez => pez.mover() }) })
	game.start()
}