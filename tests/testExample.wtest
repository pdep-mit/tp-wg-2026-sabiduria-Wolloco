import peces.*
import anzuelo.*
import piedra.*

describe "Tests de Pesca y Puntos" {
  test "Al pescar un pez comun, el anzuelo lo agarra" {
    const pezComun = new PezComun(
      position = game.at(1, 1),
      orientacion = "derecha"
    )
    anzuelo.pescar(pezComun)
    assert.equals(pezComun, anzuelo.pezAgarrado())
  }
  
  test "Al soltar, el anzuelo no tiene pez agarrado" {
    const pezRapido = new PezRapido(
      position = game.at(1, 1),
      orientacion = "derecha"
    )
    anzuelo.pescar(pezRapido)
    anzuelo.soltar()
    assert.equals(null, anzuelo.pezAgarrado())
  }
  
  test "Al llegar arriba con un pez rapido, suma 25 puntos" {
    const pezRapido = new PezRapido(
      position = game.at(1, 1),
      orientacion = "derecha"
    )
    anzuelo.pescar(pezRapido)
    anzuelo.position(game.at(5, 6))
    anzuelo.subirAnzuelo() //primero sube una unidad
    anzuelo.subirAnzuelo() //en la maxima altura, suma puntaje
    assert.equals(25, anzuelo.puntos())
  }
  
  test "Al llegar arriba con un pez comun, suma 5 puntos" {
    const pezComun = new PezComun(
      position = game.at(1, 1),
      orientacion = "derecha"
    )
    anzuelo.pescar(pezComun)
    anzuelo.position(game.at(5, 6))
    anzuelo.subirAnzuelo() //primero sube una unidad
    anzuelo.subirAnzuelo() //en la maxima altura, suma puntaje
    assert.equals(5, anzuelo.puntos())
  }

  test "Al perder todas las vidas el anzuelo queda con 0 vidas" {
    anzuelo.resetear()
    anzuelo.perderVida()
    anzuelo.perderVida()
    anzuelo.perderVida()
    assert.equals(0, anzuelo.vidas())
}

test "Al perder una vida, el anzuelo tiene una vida menos" {
    anzuelo.resetear()
    anzuelo.perderVida()
    assert.equals(2, anzuelo.vidas())
}
}

describe "Tests de Movimiento de Peces" {
  test "El comun avanza una casilla hacia la derecha" {
    game.width(10)
    game.height(10)
    const comun = new PezComun(position = game.at(3, 3), orientacion = derecha)
    comun.mover()
    assert.equals(4, comun.position().x())
  }
  
  test "El comun avanza una casilla hacia la izquierda" {
    game.width(10)
    game.height(10)
    const comun = new PezComun(
      position = game.at(3, 3),
      orientacion = izquierda
    )
    comun.mover()
    assert.equals(2, comun.position().x())
  }
  
  test "El pez comun vuelve al inicio al llegar al borde derecho" {
    game.width(10)
    const pezComun = new PezComun(
      position = game.at(game.width() - 1, 3),
      orientacion = derecha
    )
    pezComun.mover()
    assert.equals(0, pezComun.position().x())
  }
  
  test "El pez rapido vuelve al inicio despues de salir por la derecha" {
    game.width(10)
    const pezRapido = new PezRapido(
      position = game.at(10, 3),
      orientacion = derecha
    )
    pezRapido.mover()
    assert.equals(0, pezRapido.position().x())
  }
}

describe "Tests de obstaculo" {
  test "Al chocar con la piedra, el anzuelo suelta el pez" {
    anzuelo.resetear()
    const pez = new PezComun(position = game.at(3, 3), orientacion = "derecha")
    anzuelo.pescar(pez)
    piedra.interactuarCon(anzuelo)
    assert.equals(null, anzuelo.pezAgarrado())
  }
  
  test "La piedra avanza una casilla hacia la derecha" {
    piedra.position(game.at(3, 3))
    piedra.mover()
    assert.equals(4, piedra.position().x())
  }

  test "Al pescar un pez venenoso, el anzuelo pierde una vida" {
    anzuelo.resetear()
    const pezVenenoso = new PezVenenoso(position = game.at(1, 1), orientacion = derecha)
    const vidasAntes = anzuelo.vidas()
    pezVenenoso.interactuarCon(anzuelo)
    assert.equals(vidasAntes - 1, anzuelo.vidas())
}
}

describe "Tests Resumen partida" {
  test "Al pescar un pez comun y subirlo, se agrega a la colección de peces pescados" {
    const pezComun = new PezComun(position = game.at(1, 1), orientacion = derecha)
    game.addVisual(pezComun)
    
    anzuelo.pescar(pezComun)
    anzuelo.position(game.at(5, 7))
    anzuelo.subirAnzuelo() //Sube a la superficie y registra el pez en la colección
    
    assert.equals(1, anzuelo.pecesPescados().size())
    assert.that(anzuelo.pecesPescados().contains(pezComun))
  }

  test "El conteo por especie distingue correctamente entre especies" {
    const pezComun1 = new PezComun(position = game.at(1, 1), orientacion = derecha)
    const pezComun2 = new PezComun(position = game.at(2, 2), orientacion = derecha)
    const pezRapido = new PezRapido(position = game.at(3, 3), orientacion = derecha)

    game.addVisual(pezComun1)
    game.addVisual(pezComun2)
    game.addVisual(pezRapido)

    //Pescamos 2 peces comunes
    anzuelo.pescar(pezComun1)
    anzuelo.position(game.at(5, 7))
    anzuelo.subirAnzuelo()

    anzuelo.pescar(pezComun2)
    anzuelo.position(game.at(5, 7))
    anzuelo.subirAnzuelo()

    //Pescamos 1 pez rápido
    anzuelo.pescar(pezRapido)
    anzuelo.position(game.at(5, 7))
    anzuelo.subirAnzuelo()

    assert.equals(2, anzuelo.cantidadPecesComunes())
    assert.equals(1, anzuelo.cantidadPecesRapidos())
    assert.equals(3, anzuelo.pecesPescados().size())
  }

  test "Al resetear, la colección de peces pescados vuelve a estar vacía" {
    const pezComun = new PezComun(position = game.at(1, 1), orientacion = derecha)
    game.addVisual(pezComun)

    anzuelo.pescar(pezComun)
    anzuelo.position(game.at(5, 7))
    anzuelo.subirAnzuelo()

    anzuelo.resetear()

    assert.equals(0, anzuelo.pecesPescados().size())
    assert.equals(0, anzuelo.cantidadPecesComunes())
    assert.equals(0, anzuelo.cantidadPecesRapidos())
  }
}

