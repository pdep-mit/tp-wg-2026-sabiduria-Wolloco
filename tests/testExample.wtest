import peces.*
import anzuelo.*
import piedra.*
import cardumen.*
import hielo.*

describe "Tests de Pesca y Puntos" {
  test "Al pescar un pez comun, el anzuelo lo agarra" {
    const pezComun = new PezComun(
      position = game.at(1, 1),
      orientacion = "derecha"
    )
    anzuelo.pescar(pezComun)
    assert.equals(pezComun, anzuelo.pezAgarrado())
  }
  
  test "Al soltar, el anzuelo no tiene pez agarrado" {
    const pezRapido = new PezRapido(
      position = game.at(1, 1),
      orientacion = "derecha"
    )
    anzuelo.pescar(pezRapido)
    anzuelo.soltar()
    assert.equals(null, anzuelo.pezAgarrado())
  }
  
  test "Al llegar arriba con un pez rapido, suma 25 puntos" {
    const pezRapido = new PezRapido(
      position = game.at(1, 1),
      orientacion = "derecha"
    )
    anzuelo.pescar(pezRapido)
    anzuelo.position(game.at(5, 6))
    anzuelo.subirAnzuelo() //primero sube una unidad
    anzuelo.subirAnzuelo() //en la maxima altura, suma puntaje
    assert.equals(25, anzuelo.puntos())
  }
  
  test "Al llegar arriba con un pez comun, suma 5 puntos" {
    const pezComun = new PezComun(
      position = game.at(1, 1),
      orientacion = "derecha"
    )
    anzuelo.pescar(pezComun)
    anzuelo.position(game.at(5, 6))
    anzuelo.subirAnzuelo() //primero sube una unidad
    anzuelo.subirAnzuelo() //en la maxima altura, suma puntaje
    assert.equals(5, anzuelo.puntos())
  }

  test "Al perder la ultima vida termina la partida" {
  anzuelo.resetear()

  //para simular que al jugador solo le queda una vida
  anzuelo.vidas(1)

  anzuelo.perderVida()

  assert.equals(0, anzuelo.vidas())
  assert.that(anzuelo.partidaTerminada())

  anzuelo.resetear()
}

test "Al perder una vida, el anzuelo tiene una vida menos" {
    anzuelo.resetear()
    anzuelo.perderVida()
    assert.equals(2, anzuelo.vidas())
}
}

describe "Tests de Movimiento de Peces" {
  test "El comun avanza una casilla hacia la derecha" {
    game.width(10)
    game.height(10)
    const comun = new PezComun(position = game.at(3, 3), orientacion = derecha)
    comun.mover()
    assert.equals(4, comun.position().x())
  }
  
  test "El comun avanza una casilla hacia la izquierda" {
    game.width(10)
    game.height(10)
    const comun = new PezComun(
      position = game.at(3, 3),
      orientacion = izquierda
    )
    comun.mover()
    assert.equals(2, comun.position().x())
  }
  
  test "El pez comun vuelve al inicio al llegar al borde derecho" {
    game.width(10)
    const pezComun = new PezComun(
      position = game.at(game.width() - 1, 3),
      orientacion = derecha
    )
    pezComun.mover()
    assert.equals(0, pezComun.position().x())
  }
  
  test "El pez rapido vuelve al inicio despues de salir por la derecha" {
    game.width(10)
    const pezRapido = new PezRapido(
      position = game.at(10, 3),
      orientacion = derecha
    )
    pezRapido.mover()
    assert.equals(0, pezRapido.position().x())
  }
}

describe "Tests de obstaculo" {
  test "Al chocar con la piedra, el anzuelo suelta el pez" {
    anzuelo.resetear()
    const pez = new PezComun(position = game.at(3, 3), orientacion = "derecha")
    anzuelo.pescar(pez)
    piedra.interactuarCon(anzuelo)
    assert.equals(null, anzuelo.pezAgarrado())
  }
  
  test "La piedra avanza una casilla hacia la derecha" {
    piedra.position(game.at(3, 3))
    piedra.mover()
    assert.equals(4, piedra.position().x())
  }

  test "Al pescar un pez venenoso, el anzuelo pierde una vida" {
    anzuelo.resetear()
    const pezVenenoso = new PezVenenoso(position = game.at(1, 1), orientacion = derecha)
    const vidasAntes = anzuelo.vidas()
    pezVenenoso.interactuarCon(anzuelo)
    assert.equals(vidasAntes - 1, anzuelo.vidas())
}


test "La piedra quita exactamente dos vidas por choque" {
  anzuelo.resetear()

  piedra.interactuarCon(anzuelo)

  assert.equals(1, anzuelo.vidas())

  piedra.interactuarCon(anzuelo)

  assert.equals(1, anzuelo.vidas())

  anzuelo.resetear()
}

test "Al interactuar con el hielo, el anzuelo queda congelado"{
  anzuelo.resetear()
  hielo.interactuarCon(anzuelo)
  assert.that(anzuelo.congelado())
}

}

describe "Tests Resumen partida" {
  test "Al pescar un pez comun y subirlo, se agrega a la colección de peces pescados" {
    const pezComun = new PezComun(position = game.at(1, 1), orientacion = derecha)
    game.addVisual(pezComun)
    
    anzuelo.pescar(pezComun)
    anzuelo.position(game.at(5, 7))
    anzuelo.subirAnzuelo() 
    
    assert.equals(1, anzuelo.pecesPescados().size())
    assert.that(anzuelo.pecesPescados().contains(pezComun))
  }

  test "El conteo por especie distingue correctamente entre especies" {
    const pezComun1 = new PezComun(position = game.at(1, 1), orientacion = derecha)
    const pezComun2 = new PezComun(position = game.at(2, 2), orientacion = derecha)
    const pezRapido = new PezRapido(position = game.at(3, 3), orientacion = derecha)

    game.addVisual(pezComun1)
    game.addVisual(pezComun2)
    game.addVisual(pezRapido)

    //Pescamos 2 peces comunes
    anzuelo.pescar(pezComun1)
    anzuelo.position(game.at(5, 7))
    anzuelo.subirAnzuelo()

    anzuelo.pescar(pezComun2)
    anzuelo.position(game.at(5, 7))
    anzuelo.subirAnzuelo()

    //Pescamos 1 pez rápido
    anzuelo.pescar(pezRapido)
    anzuelo.position(game.at(5, 7))
    anzuelo.subirAnzuelo()

    assert.equals(2, anzuelo.cantidadPecesComunes())
    assert.equals(1, anzuelo.cantidadPecesRapidos())
    assert.equals(3, anzuelo.pecesPescados().size())
  }

  test "Al resetear, la colección de peces pescados vuelve a estar vacía" {
    const pezComun = new PezComun(position = game.at(1, 1), orientacion = derecha)
    game.addVisual(pezComun)

    anzuelo.pescar(pezComun)
    anzuelo.position(game.at(5, 7))
    anzuelo.subirAnzuelo()

    anzuelo.resetear()

    assert.equals(0, anzuelo.pecesPescados().size())
    assert.equals(0, anzuelo.cantidadPecesComunes())
    assert.equals(0, anzuelo.cantidadPecesRapidos())
  }
}

describe "Tests Peces del Cardumen" {
  test "Un pez del cardumen vale 20 puntos" {
    const pez = new PezCardumen(
      position = game.at(2, 3),
      orientacion = derecha
    )

    assert.equals(20, pez.daPuntos())
  }

  test "El rey tambien vale 20 puntos" {
    const rey = new PezRey(
      position = game.at(2, 3),
      orientacion = derecha
    )

    assert.equals(20, rey.daPuntos())
  }


  test "Un pez del cardumen se mueve como uno comun" {
    game.width(10)

    const pez = new PezCardumen(
      position = game.at(2, 3),
      orientacion = derecha
    )

    pez.mover()

    assert.equals(3, pez.position().x())
  }
}


describe "Tests Cardumen" {
  test "El cardumen tiene dos seguidores y un rey" {
    assert.equals(3, cardumen.peces().size())

    assert.equals(2, cardumen.peces().count({
      pez => pez.nombreImagen() == "pezCardumen"
    }))

    assert.equals(1, cardumen.peces().count({
      pez => pez.nombreImagen() == "pezRey"
    }))
  }

  test "El cardumen avanza junto manteniendo su formacion" {
  game.width(10)
  game.height(10)

  const peces = cardumen.peces()

  peces.get(0).position(game.at(0, 4))
  peces.get(1).position(game.at(2, 4))
  peces.get(2).position(game.at(4, 4))

  cardumen.reiniciar()
  cardumen.aparecer()
  cardumen.mover()

  assert.equals(1, peces.get(0).position().x())
  assert.equals(3, peces.get(1).position().x())
  assert.equals(5, peces.get(2).position().x())

  assert.that(peces.all({
    pez => pez.position().y() == 4
  }))

  cardumen.reiniciar()
}


test "El cardumen vuelve a aparecer sin recuperar peces pescados" {
  anzuelo.resetear()
  cardumen.reiniciar()
  cardumen.aparecer()

  const seguidor = cardumen.peces().get(0)
  const rey = cardumen.peces().get(1)
  const otroSeguidor = cardumen.peces().get(2)

  anzuelo.pescar(seguidor)
  anzuelo.position(game.at(4, 7))
  anzuelo.subirAnzuelo()

  rey.position(game.at(9, 4))
  otroSeguidor.position(game.at(9, 4))

  cardumen.mover()

  assert.that(!game.hasVisual(rey))
  assert.that(!game.hasVisual(otroSeguidor))

  cardumen.aparecer()

  assert.that(game.hasVisual(rey))
  assert.that(game.hasVisual(otroSeguidor))
  assert.that(seguidor.estaPescado())
  assert.equals(2, cardumen.pecesDisponibles().size())

  cardumen.reiniciar()
  anzuelo.resetear()
}


test "Al pescar un seguidor quedan dos peces disponibles" {
  cardumen.reiniciar()
  cardumen.aparecer()

  const seguidor = cardumen.peces().get(0)

  seguidor.estaPescado(true)

  assert.equals(2, cardumen.pecesDisponibles().size())

  cardumen.reiniciar()
}

test "Al pescar al rey se capturan los tres integrantes" {
  anzuelo.resetear()
  cardumen.reiniciar()
  cardumen.aparecer()

  const rey = cardumen.peces().get(1)

  anzuelo.pescarCardumen(rey, cardumen.pecesDisponibles())

  assert.equals(rey, anzuelo.pezAgarrado())
  assert.equals(2, anzuelo.pecesAcompaniantes().size())

  assert.that(cardumen.peces().all({
    pez => pez.estaPescado()
  }))

  cardumen.reiniciar()
  anzuelo.resetear()
}


test "Al tocar al rey se engancha todo el cardumen" {
  anzuelo.resetear()
  cardumen.reiniciar()
  cardumen.aparecer()

  const rey = cardumen.peces().get(1)

  rey.interactuarCon(anzuelo)

  assert.equals(rey, anzuelo.pezAgarrado())
  assert.equals(2, anzuelo.pecesAcompaniantes().size())

  cardumen.reiniciar()
  anzuelo.resetear()
}


test "Los tres peces siguen al anzuelo" {
  anzuelo.resetear()
  cardumen.reiniciar()
  cardumen.aparecer()

  const rey = cardumen.peces().get(1)

  rey.interactuarCon(anzuelo)

  anzuelo.position(game.at(4, 5))
  anzuelo.moverPezAgarrado()

assert.equals(game.at(4, 5), rey.position())

assert.equals(
  game.at(4, 4),
  anzuelo.pecesAcompaniantes().get(0).position()
)

assert.equals(
  game.at(4, 3),
  anzuelo.pecesAcompaniantes().get(1).position()
)

  cardumen.reiniciar()
  anzuelo.resetear()
}

test "Al subir el cardumen completo suma 60 puntos" {
  anzuelo.resetear()
  cardumen.reiniciar()
  cardumen.aparecer()

  const rey = cardumen.peces().get(1)

  rey.interactuarCon(anzuelo)

  anzuelo.position(game.at(4, 7))
  anzuelo.subirAnzuelo()

  assert.equals(60, anzuelo.puntos())
  assert.equals(3, anzuelo.pecesPescados().size())
  assert.equals(null, anzuelo.pezAgarrado())
  assert.equals(0, anzuelo.pecesAcompaniantes().size())

  cardumen.reiniciar()
  anzuelo.resetear()
}

test "Soltar el cardumen libera a todos sin perder vidas" {
  anzuelo.resetear()
  cardumen.reiniciar()
  cardumen.aparecer()

  const rey = cardumen.peces().get(1)

  rey.interactuarCon(anzuelo)

  const vidasAntes = anzuelo.vidas()

  anzuelo.soltar()

  assert.equals(null, anzuelo.pezAgarrado())
  assert.equals(0, anzuelo.pecesAcompaniantes().size())
  assert.equals(vidasAntes, anzuelo.vidas())

  assert.that(cardumen.peces().all({
    pez => !pez.estaPescado()
  }))

  cardumen.reiniciar()
  anzuelo.resetear()
}

test "El rey captura solamente los peces restantes" {
  anzuelo.resetear()
  cardumen.reiniciar()
  cardumen.aparecer()

  const seguidor = cardumen.peces().get(0)
  const rey = cardumen.peces().get(1)

  //1ero se pesca un seguidor
  anzuelo.pescar(seguidor)
  anzuelo.position(game.at(4, 7))
  anzuelo.subirAnzuelo()

  assert.equals(20, anzuelo.puntos())

  //2do se pesca al rey
  rey.interactuarCon(anzuelo)

  assert.equals(1, anzuelo.pecesAcompaniantes().size())

  anzuelo.subirAnzuelo()

  //el rey y el seguidor restante suman 40 puntos
  assert.equals(60, anzuelo.puntos())
  assert.equals(3, anzuelo.pecesPescados().size())

  cardumen.reiniciar()
  anzuelo.resetear()
}


test "El resumen cuenta los tres peces del cardumen" {
  anzuelo.resetear()
  cardumen.reiniciar()
  cardumen.aparecer()

  const rey = cardumen.peces().get(1)

  rey.interactuarCon(anzuelo)
  anzuelo.position(game.at(4, 7))
  anzuelo.subirAnzuelo()

  assert.equals(3, anzuelo.cantidadPecesCardumen())

  cardumen.reiniciar()
  anzuelo.resetear()
}

test "El rey solo se pesca por 20 puntos" {
  anzuelo.resetear()
  cardumen.reiniciar()
  cardumen.aparecer()

  const seguidor1 = cardumen.peces().get(0)
  const rey = cardumen.peces().get(1)
  const seguidor2 = cardumen.peces().get(2)

  //se pescan los dos seguidores individualmente
  anzuelo.pescar(seguidor1)
  anzuelo.position(game.at(4, 7))
  anzuelo.subirAnzuelo()

  anzuelo.pescar(seguidor2)
  anzuelo.subirAnzuelo()

  assert.equals(40, anzuelo.puntos())

  //queda solo el rey
  rey.interactuarCon(anzuelo)

  assert.equals(0, anzuelo.pecesAcompaniantes().size())

  anzuelo.subirAnzuelo()

  assert.equals(60, anzuelo.puntos())
  assert.equals(3, anzuelo.cantidadPecesCardumen())

  cardumen.reiniciar()
  anzuelo.resetear()
}

}



describe "Tests de Estados del Anzuelo" {
  test "Teniendo un pez agarrado no engancha otro pez no danino" {
    anzuelo.resetear()
    const pez1 = new PezComun(position = game.at(2, 2), orientacion = derecha)
    const pez2 = new PezRapido(position = game.at(2, 2), orientacion = derecha)

    anzuelo.pescar(pez1)
    anzuelo.pescar(pez2)

    assert.equals(pez1, anzuelo.pezAgarrado())
    assert.that(!pez2.estaPescado())
    anzuelo.resetear()
  }

  test "Estando congelado el anzuelo no sube ni baja" {
    anzuelo.resetear()
    anzuelo.position(game.at(4, 4))
    anzuelo.congelar()

    anzuelo.subirAnzuelo()
    assert.equals(4, anzuelo.position().y())

    anzuelo.bajarAnzuelo()
    assert.equals(4, anzuelo.position().y())

    anzuelo.resetear()
  }

  test "Estando invulnerable no pierde vidas ni se congela" {
    anzuelo.resetear()
    anzuelo.perderVida() //pasa a 2 vidas y al estado invulnerable

    anzuelo.perderVidas(2)
    anzuelo.congelar()

    assert.equals(2, anzuelo.vidas())
    assert.that(anzuelo.invulnerable())
    assert.that(!anzuelo.congelado())
    anzuelo.resetear()
  }
}